{
  "name": "mdiv",
  "version": "0.1.1",
  "description": "Local Azure DevOps Wiki flavored Markdown previewer.",
  "bin": {
    "mdiv": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:version": "bun run scripts/check-version.ts",
    "version": "bun run scripts/update-version.ts",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run check:version && bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/markdown-it": "^14.1.2",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.14.0",
    "typescript": "^5.9.3"
  }
}
