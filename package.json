{
  "name": "mdiv",
  "version": "0.2.1",
  "description": "Local Azure DevOps Wiki flavored Markdown previewer.",
  "bin": {
    "mdiv": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:embed": "bun run scripts/embed-web.ts",
    "build": "bun run build:web && bun run build:embed && bun build src/cli.ts --target=bun --outfile=dist/cli.js",
    "test": "bun test test/core test/flavors test/server && bun run test:web",
    "test:web": "bun test --preload ./test/setup/dom.ts test/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "check:version": "bun run scripts/check-version.ts",
    "version": "bun run scripts/update-version.ts",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run check:version && bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.14.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
